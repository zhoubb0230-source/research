// 🗺️ 洞察规划专家 —— agents.entries["insight-planner"]
// install.sh 把本文件合并进生成的 openclaw.json 的 agents.entries 下。
// 正本人格与技能：../../expert-team/experts/insight-planner/
//
// 装配理由：分诊要判断「知识库里有没有未过期的同题结论」，需要检索能力，但不需要浏览器自动化。
{
  "workspace": "<WORKSPACE_ROOT>/insight-planner",
  "agentDir": "~/.openclaw/agents/insight-planner/agent",
  "identity": { "name": "洞察规划专家", "emoji": "🗺️" },

  "model": "anthropic/claude-opus-5",
  "thinkingDefault": "high",
  "contextInjection": "always",

  "tools": {
    "profile": "coding",
    "deny": ["canvas", "nodes", "cron", "gateway", "image", "exec", "process", "browser", "sessions_spawn"]
  },

  "skills": ["triage-and-brief"],

  // 叶子角色不派发：tools.deny 里已有 sessions_spawn，这里不再声明 allowAgents。
  // OpenClaw 的默认值本就是「只能派自己」，两条合起来是双保险。

  "sandbox": { "mode": "off" }
}
