{
  "_comment": "业务洞察专家团 · OpenClaw 角色定义。install.sh 读取本文件生成各 agent 的 workspace。角色提示词正文来自 ../expert-team/prompts/，本文件只描述 OpenClaw 侧的装配元数据，不复制提示词内容。",
  "_promptDir": "../expert-team/prompts",
  "_sharedGuardrails": "_shared-guardrails.md",
  "roles": [
    {
      "agentId": "chief-coordinator",
      "nameCn": "洞察总调度",
      "emoji": "🧭",
      "legacyId": "G1",
      "promptFile": "00-orchestrator.md",
      "depth": 0,
      "stages": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6",
        "P7",
        "P8",
        "P9"
      ],
      "model": "anthropic/claude-opus-5",
      "thinking": "high",
      "canSpawn": true,
      "allowAgents": [
        "rubric-owner",
        "opportunity-scanner",
        "data-collector",
        "industry-analyst",
        "techchain-analyst",
        "red-team-challenger",
        "fact-verifier",
        "compliance-officer",
        "arbiter",
        "insight-director",
        "report-writer"
      ],
      "spawnContext": null,
      "inputs": [
        "经纬线原文",
        "业务约束"
      ],
      "outputs": [
        "阶段状态",
        "批次台账"
      ],
      "forbidden": [
        "产出任何内容判断",
        "代替专家给分",
        "在校验未过时放行 P8"
      ],
      "note": "唯一的 main agent。只推进状态机，不做内容判断。",
      "playbook": "playbook.md"
    },
    {
      "agentId": "rubric-owner",
      "nameCn": "口径定义专家",
      "emoji": "📐",
      "legacyId": "G2",
      "promptFile": "01-rubric-owner.md",
      "depth": 1,
      "stages": [
        "P0"
      ],
      "model": "anthropic/claude-opus-5",
      "thinking": "high",
      "canSpawn": false,
      "spawnContext": "isolated",
      "inputs": [
        "经纬线原文",
        "业务约束"
      ],
      "outputs": [
        "rubric-vN.yaml"
      ],
      "forbidden": [
        "在筛选进行中修改已冻结的 rubric",
        "引入无法判定的软性维度"
      ],
      "note": "口径唯一真相源。一轮只跑一次。"
    },
    {
      "agentId": "opportunity-scanner",
      "nameCn": "机会枚举专家",
      "emoji": "🔭",
      "legacyId": "S1",
      "promptFile": "02-opportunity-scanner.md",
      "depth": 1,
      "stages": [
        "P1"
      ],
      "model": "anthropic/claude-opus-5",
      "thinking": "medium",
      "canSpawn": false,
      "spawnContext": "isolated",
      "toolsNeeded": [
        "web"
      ],
      "inputs": [
        "rubric",
        "产业目录来源清单"
      ],
      "outputs": [
        "opportunity.schema.json[]"
      ],
      "forbidden": [
        "价值判断",
        "无 enumerated_from 的自由联想候选",
        "停留在行业层的粗颗粒度"
      ],
      "note": "只负责覆盖率，宁滥勿缺。淘汰是闸门的事。"
    },
    {
      "agentId": "data-collector",
      "nameCn": "数据采集专家",
      "emoji": "🔍",
      "legacyId": "S2",
      "promptFile": "03-evidence-collector.md",
      "depth": 1,
      "stages": [
        "P3",
        "P7"
      ],
      "model": "anthropic/claude-sonnet-5",
      "thinking": "medium",
      "canSpawn": true,
      "allowAgents": [
        "data-collector"
      ],
      "spawnContext": "isolated",
      "toolsNeeded": [
        "web"
      ],
      "inputs": [
        "机会通过池",
        "指标清单"
      ],
      "outputs": [
        "evidence.schema.json（证据卡）"
      ],
      "forbidden": [
        "估算",
        "外推",
        "类比推算",
        "用「约/预计/大致/业内普遍认为」填充",
        "把多来源数字平均",
        "下结论"
      ],
      "note": "本系统成本占比最高的角色，可自我 fan-out 为 depth-2 采集工蜂。产出证据卡，不产出结论。"
    },
    {
      "agentId": "industry-analyst",
      "nameCn": "产业分析专家",
      "emoji": "📊",
      "legacyId": "S3",
      "promptFile": "04-industry-analyst.md",
      "depth": 1,
      "stages": [
        "P4",
        "P7"
      ],
      "model": "anthropic/claude-opus-5",
      "thinking": "high",
      "canSpawn": false,
      "spawnContext": "isolated",
      "inputs": [
        "证据库",
        "rubric"
      ],
      "outputs": [
        "scorecard.schema.json（B/C/D/E 维 + g 修正项）"
      ],
      "forbidden": [
        "自己取数",
        "给档间分（7 分 9 分）",
        "自造锚点档位",
        "无证据支撑的给分"
      ],
      "note": "负责 B/C/D/E 四维与 g 修正项。只能引用证据库。"
    },
    {
      "agentId": "techchain-analyst",
      "nameCn": "技术链分析专家",
      "emoji": "⚙️",
      "legacyId": "S4",
      "promptFile": "05-techchain-analyst.md",
      "depth": 1,
      "stages": [
        "P4",
        "P7"
      ],
      "model": "anthropic/claude-opus-5",
      "thinking": "high",
      "canSpawn": false,
      "spawnContext": "isolated",
      "knowledgePack": "semiconductor-equipment-v1",
      "inputs": [
        "证据库",
        "rubric",
        "领域知识包"
      ],
      "outputs": [
        "scorecard.schema.json（A/F 维 + h 修正项 + sub_capability_hits）"
      ],
      "forbidden": [
        "A 维给整体印象分",
        "凭技术印象判定 TRL",
        "跳过 sub_capability_hits 逐项判定"
      ],
      "note": "负责最高权重的 A 维（25 分）与 F 维、h 修正项。"
    },
    {
      "agentId": "red-team-challenger",
      "nameCn": "质疑审查专家",
      "emoji": "🥊",
      "legacyId": "C1",
      "promptFile": "06-red-team.md",
      "depth": 1,
      "stages": [
        "P5",
        "P7"
      ],
      "model": "anthropic/claude-fable-5",
      "thinking": "high",
      "canSpawn": false,
      "spawnContext": "isolated",
      "isolationRequired": true,
      "inputs": [
        "评分卡结论",
        "证据库"
      ],
      "inputsExcluded": [
        "分析专家的推理过程"
      ],
      "outputs": [
        "verdict.schema.json（falsification_memo + challenges + most_likely_wrong）"
      ],
      "forbidden": [
        "修改分值",
        "第 2 轮重复第 1 轮论点",
        "无 evidence_ref 的 counterexample",
        "为凑数把 minor 报成 major"
      ],
      "note": "必须与分析专家异源：不同模型 + spawn 时强制 context=isolated。KPI 是推翻/降级数。"
    },
    {
      "agentId": "fact-verifier",
      "nameCn": "数据核证专家",
      "emoji": "✅",
      "legacyId": "C2",
      "promptFile": "07-fact-checker.md",
      "depth": 1,
      "stages": [
        "P3",
        "P7"
      ],
      "model": "anthropic/claude-sonnet-5",
      "thinking": "medium",
      "canSpawn": false,
      "spawnContext": "isolated",
      "toolsNeeded": [
        "web"
      ],
      "inputs": [
        "证据卡"
      ],
      "outputs": [
        "证据卡的 verify_status / verified_by / conflict_with"
      ],
      "forbidden": [
        "因数字「看起来合理」就放过",
        "在 conflicting 时挑一个更可信的",
        "补充新证据",
        "修改分数"
      ],
      "note": "硬闸门。只有判定为 verified 的证据能进入评分。"
    },
    {
      "agentId": "compliance-officer",
      "nameCn": "合规管制专家",
      "emoji": "🛡️",
      "legacyId": "C3",
      "promptFile": "08-compliance-officer.md",
      "depth": 1,
      "stages": [
        "P2",
        "P4",
        "P7"
      ],
      "model": "anthropic/claude-opus-5",
      "thinking": "high",
      "canSpawn": false,
      "spawnContext": "isolated",
      "toolsNeeded": [
        "web"
      ],
      "inputs": [
        "候选机会",
        "管制清单原文"
      ],
      "outputs": [
        "adjustments.i（双向）",
        "G-3 / G-4 闸门判定"
      ],
      "forbidden": [
        "凭记忆判定管制状态",
        "把 undetermined 当作 not_restricted",
        "在缺版本/生效日期时给结论",
        "产出合规意见"
      ],
      "note": "承担 G-3、G-4 闸门与 i 修正项。判定必须回原文并给条目定位。"
    },
    {
      "agentId": "arbiter",
      "nameCn": "争议仲裁专家",
      "emoji": "⚖️",
      "legacyId": "A1",
      "promptFile": "09-arbiter.md",
      "depth": 1,
      "stages": [
        "P6",
        "P7"
      ],
      "model": "anthropic/claude-opus-5",
      "thinking": "high",
      "canSpawn": false,
      "spawnContext": "isolated",
      "inputs": [
        "评分卡",
        "质疑记录"
      ],
      "outputs": [
        "verdict.schema.json（verdicts）",
        "终版榜单"
      ],
      "forbidden": [
        "投票",
        "取中值",
        "自己补充证据"
      ],
      "note": "按证据等级裁决。unresolved 的默认动作是降置信度，不是取中值。"
    },
    {
      "agentId": "insight-director",
      "nameCn": "首席洞察专家",
      "emoji": "🎯",
      "legacyId": "A2",
      "promptFile": "10-chief-insight-officer.md",
      "depth": 1,
      "stages": [
        "P8"
      ],
      "model": "anthropic/claude-fable-5",
      "thinking": "high",
      "canSpawn": false,
      "spawnContext": "isolated",
      "inputs": [
        "深度分析产出"
      ],
      "outputs": [
        "验收意见（通过 / 打回 + 具体不合格项）"
      ],
      "forbidden": [
        "修改任何数据、分值或证据",
        "新增结论",
        "删除不确定性标注"
      ],
      "note": "只回答「这份产出对决策有没有用」。有权打回，无权改数。"
    },
    {
      "agentId": "report-writer",
      "nameCn": "报告生成专家",
      "emoji": "📝",
      "legacyId": "A3",
      "promptFile": "11-report-renderer.md",
      "depth": 1,
      "stages": [
        "P8"
      ],
      "model": "anthropic/claude-haiku-4-5",
      "thinking": "low",
      "canSpawn": false,
      "spawnContext": "isolated",
      "sandbox": "all",
      "publishGate": "bin/publish-report.sh",
      "inputs": [
        "结构化分析 JSON",
        "输出模板"
      ],
      "outputs": [
        "Markdown 报告（草稿区）"
      ],
      "forbidden": [
        "引入新数字",
        "引入新实体",
        "引入新因果断言",
        "删除不确定性标注",
        "把 NA 一带而过",
        "把区间写成点值",
        "强化确定性措辞",
        "直接写入发布目录"
      ],
      "note": "只做措辞改写。发布必须经 bin/publish-report.sh —— 它内部跑 verify_report.py，不过则不落盘。"
    }
  ]
}
