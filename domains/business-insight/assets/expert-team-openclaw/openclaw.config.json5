// ===========================================================================
// 业务洞察专家团 · OpenClaw 编排框架
// ---------------------------------------------------------------------------
// 本文件只含【全局层】：agents.defaults、bindings、skills 加载策略。
// 12 位专家的 agents.entries 片段各自住在 experts/<agentId>/entry.json5，
// 由 install.sh 合并进来 —— 这样改一位专家不会碰到别人。
//
// 合并到 ~/.openclaw/openclaw.json。不要整体覆盖你已有的配置：
// install.sh 做键级合并，并在写入前备份原配置。
//
// 本文件是「带注释的人类可读主本」。install.sh 剥离整行 // 注释后生成严格 JSON，
// 因此刻意不使用行尾注释与尾逗号。
//
// 所有 <占位> 必须替换后才能上线，install.sh 会检查残留占位符并拒绝写入。
// ===========================================================================
{
  "agents": {
    // 多 agent 舰队必须显式绑定。没有匹配 binding 的入站消息 fail closed，
    // 而不是悄悄落到某个 agent 上。
    "ownership": "explicit",

    "defaults": {
      // ---- 引导文件 ----
      // 我们自己管理全部工作区文件（install.sh 生成），
      // 所以关掉 OpenClaw 的自动播种，避免它写入 BOOTSTRAP.md 之类的模板文件。
      "skipBootstrap": true,

      // always：每轮都注入工作区引导文件。
      // 洞察是长流水线，continuation-skip 会让中途某些轮次丢掉角色约束与护栏。
      "contextInjection": "always",

      // 实测 12 位专家的引导文件在 3629–4072 字符之间，离这两条上限很远。
      // 保留默认值即可；若日后往 SOUL/AGENTS 里加内容，注意别顶到 20000。
      "bootstrapMaxChars": 20000,
      "bootstrapTotalMaxChars": 60000,

      // ---- 模型 ----
      // defaults 只作兜底。12 位专家全部在自己的 entry.json5 里显式指定 model，
      // 用字符串形态（= 严格主模型、无 fallback）：
      // 批次中途悄悄换模型会让跨对象的结论不可比。
      "model": { "primary": "anthropic/claude-opus-5", "fallbacks": [] },
      "utilityModel": "anthropic/claude-haiku-4-5",
      "thinkingDefault": "high",

      // ---- 子 Agent 派发 ----
      "subagents": {
        // 必须 >= 2：depth-1 只有在 maxSpawnDepth >= 2 时才被授予 sessions_spawn。
        // 数据采集专家需要这项权限才能 fan-out 出 depth-2 采集工蜂。
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 20,
        // 全局并发车道。受你的模型速率限制约束，需实测回调。
        "maxConcurrent": 12,
        // 禁止不指名的模糊派发。
        "requireAgentId": true,
        // 取证类任务远超默认的 120000（2 分钟）。
        "announceTimeoutMs": 600000,
        // 0 = 不设运行超时。长批次的深度动作可能跑很久。
        "runTimeoutSeconds": 0,
        // 长批次中途不要把子会话归档掉。
        "archiveAfterMinutes": 240
      }
    },

    // ---- 12 位专家 ----
    // 由 install.sh 从 experts/<agentId>/entry.json5 逐一读入并填在这里。
    // 直接编辑生成产物会在下次 install 时被覆盖 —— 改 entry.json5。
    "entries": {}
  },

  // -------------------------------------------------------------------------
  // 通道绑定：只有洞察总调度对人暴露
  // -------------------------------------------------------------------------
  // 其余 11 位仅作为 sessions_spawn 的目标存在，人不直接对它们说话。
  // 这不只是习惯问题：给某位专家开一条人类通道，就等于给了它一条绕过
  // 状态机与闸门的入口。
  "bindings": [
    {
      "agentId": "chief-coordinator",
      "match": {
        "channel": "<CHANNEL>",
        "accountId": "<ACCOUNT_ID>"
      }
    }
  ],

  // -------------------------------------------------------------------------
  // 会话与消息
  // -------------------------------------------------------------------------
  "session": {
    // 洞察是长任务。按日重置会在批次中途切断上下文。
    "reset": { "mode": "off" }
  },

  // -------------------------------------------------------------------------
  // Hooks（可选，第二重保险）
  // -------------------------------------------------------------------------
  // ⚠️ OpenClaw 的 internal hooks 【没有 deny/cancel 语义】，只能注入与记录，
  //    不能阻断任何动作。真正的阻断闸是 bin/publish-report.sh。
  //    把校验挂在 hook 上会制造「已经校验过」的错觉，比没有闸更危险。
  "hooks": {
    "internal": {
      "entries": {
        "bootstrap-guardrails": {
          "enabled": true,
          "env": {
            "GUARDRAILS_PATH": "<REPO>/domains/business-insight/assets/expert-team/experts/_shared/GUARDRAILS.md"
          }
        },
        "run-ledger": { "enabled": true }
      }
    }
  },

  "messages": {
    "queue": {
      // followup：新消息排队，等当前 run 结束再处理。
      // 默认的 steer 会把新消息注入正在跑的 run，可能污染阶段产出。
      "mode": "followup"
    }
  }
}
